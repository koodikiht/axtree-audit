{
  "name": "axtree-audit",
  "version": "0.1.0",
  "description": "Out-of-band CDP Accessibility Tree (AXTree) WCAG 2.2 verifier and third-party telemetry inspector (SARIF v2.1.0 and W3C EARL)",
  "license": "MIT",
  "author": "Mark (malfunctionAI) <contact@koodikiht.dev>",
  "homepage": "https://github.com/koodikiht/axtree-audit",
  "repository": {
    "type": "git",
    "url": "https://github.com/koodikiht/axtree-audit.git"
  },
  "type": "module",
  "bin": {
    "axtree-audit": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/axtree-audit"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "axtree",
    "cdp",
    "webdriver-bidi",
    "earl",
    "sarif",
    "privacy",
    "screen-reader"
  ]
}
